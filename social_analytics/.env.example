# Instagram Graph API
# Get these from developers.facebook.com -> Your App -> Instagram Basic Display
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here
INSTAGRAM_USER_ID=your_instagram_user_id_here

# TikTok API
# Get these from developers.tiktok.com -> Your App -> Credentials
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here

# Email Report (uses Gmail SMTP or any SMTP provider)
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password_here
REPORT_RECIPIENTS=you@gmail.com,teammate@gmail.com

# Slack Report
SLACK_ENABLED=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Report schedule: day of week (mon/tue/wed/thu/fri/sat/sun) and time (24h HH:MM)
REPORT_DAY=mon
REPORT_TIME=09:00

# Data retention (days of history to keep)
DATA_RETENTION_DAYS=365
